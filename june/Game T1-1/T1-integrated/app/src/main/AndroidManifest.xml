<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- Потрібно для Firebase Remote Config і завантаження реклами -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:ignore="AdvertisingIdPolicy" />

    <!-- правка 6.1: Android 13+ — уведомления только с runtime-разрешением.
         Запрашивается НЕ на старте, а своим диалогом с наградой
         (MainActivity.maybeShowPushOptIn) — голый системный диалог на сплэше
         выжигает разрешение навсегда (два отказа = больше не покажется) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RbuxCounter">
        <activity
            android:name=".StartActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- правка 7: возврат из веб-лендинга с монетами. Схема своя у каждого
                 приложения; ЭТУ строку сообщить нам — впишем в карточку
                 (deeplink_scheme), и лендинг начнёт показывать кнопку возврата -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- reward — людина вивела монети на лендінгу і повертається за ними
                     optin  — тапнула на лендінгу «увімкнути нотифікації» -->
                <data android:scheme="rohumex" />
                <data android:host="reward" />
                <data android:host="optin" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- правка 6.3: приём ротации FCM-токена (onNewToken). Уведомлений этап 1
             не шлёт — токены копятся на сервере под будущую FCM-рассылку -->
        <service
            android:name=".businesModule.push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
    </application>

</manifest>