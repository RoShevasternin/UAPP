<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Runtime permissions. The dialer role itself is granted separately, through
         RoleManager — it is not a permission and has no runtime dialog of its own. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!--
        Declared because the brief asks for it. Strictly it belongs to self-managed
        calls (own ConnectionService), which never reach a default dialer's
        InCallService — this PoC does not use one, so nothing depends on it.
    -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <!-- Lets the app discover a Custom Tabs provider (package visibility, API 30+). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_dialer"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DialerPoC">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                ROLE_DIALER is only offered to an app that can also answer ACTION_DIAL.
                Without BOTH of these filters the app never appears in the system's
                "Phone app" picker, and createRequestRoleIntent() comes back empty —
                this is the step most dialer walkthroughs leave out.
            -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!--
            The in-call screen. showWhenLocked/turnScreenOn are what make it appear
            on a locked, dark phone the way a real incoming-call screen does.
            excludeFromRecents keeps a finished call out of the recents list.
        -->
        <activity
            android:name=".CallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:theme="@style/Theme.DialerPoC.Call"
            android:turnScreenOn="true" />

        <!--
            Telecom binds this once the app holds the dialer role, and hands it every
            call on the device. IN_CALL_SERVICE_UI = true says we draw the call screen
            ourselves instead of letting the system dialer do it.
        -->
        <service
            android:name=".CustomInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
    </application>
</manifest>
