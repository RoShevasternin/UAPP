<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the app discover a Custom Tabs provider (package visibility, API 30+). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_assist"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AssistRolePoC">

        <!--
            singleTask: the assist gesture can fire repeatedly, and we want the
            same instance brought forward (onNewIntent) instead of a stack of copies.

            The ASSIST intent-filter is what makes the app eligible to be picked as
            the "Digital assistant app". A role is NOT declared in the manifest —
            eligibility for android.app.role.ASSISTANT is derived from this filter.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
