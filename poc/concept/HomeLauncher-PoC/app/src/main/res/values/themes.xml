<resources>
    <!-- Launcher window: transparent, the system wallpaper shows behind the app grid. -->
    <style name="Theme.HomeLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

    <!-- White text with a soft shadow stays readable on any wallpaper. -->
    <style name="LauncherText">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:shadowDy">1</item>
    </style>
</resources>
