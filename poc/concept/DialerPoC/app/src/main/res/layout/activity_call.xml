<?xml version="1.0" encoding="utf-8"?>
<!--
    The in-call screen: the HomeLauncher-PoC card in the middle, call controls below.

    The card is the payload of the PoC — while the app holds the dialer role this is what
    a user sees for the whole length of every call, in place of the system's call screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_bg"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp">

    <!-- Who is calling, and what the call is doing right now. -->
    <TextView
        android:id="@+id/callState"
        style="@style/CardText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:letterSpacing="0.04"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/callNumber"
        style="@style/CardText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:alpha="0.75"
        android:textSize="26sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Ported card: banner + caption, both tappable, both open the link. -->
    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/cardImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/card_image_bg"
            android:clickable="true"
            android:contentDescription="@string/card_text"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:src="@drawable/home_banner" />

        <TextView
            android:id="@+id/cardText"
            style="@style/CardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/card_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:alpha="0.7"
            android:text="@string/card_hint"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Answer is only shown while ringing; hang-up doubles as reject. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnAnswer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/btn_answer_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingVertical="18dp"
            android:text="@string/action_answer"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHangup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_hangup_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingVertical="18dp"
            android:text="@string/action_hangup"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
