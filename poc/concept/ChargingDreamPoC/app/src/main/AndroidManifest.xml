<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Keeps a process alive so we can catch ACTION_POWER_CONNECTED at runtime. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- targetSdk >= 34: a foreground service must declare a typed permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- API 33+: without this the service/charger notifications never appear. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the app discover a Custom Tabs provider (package visibility, API 30+). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_charging"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChargingDreamPoC">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Keeps a live process so PowerConnectionReceiver can be registered at
            RUNTIME. A manifest-declared receiver for ACTION_POWER_CONNECTED is
            ignored since API 26, so the receiver is NOT declared here on purpose.
            specialUse + the property below are required for targetSdk >= 34.
        -->
        <service
            android:name=".ChargingMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Notifies the user when the charger is connected (PoC)." />
        </service>
    </application>
</manifest>
