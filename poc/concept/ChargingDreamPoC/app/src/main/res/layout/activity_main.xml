<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!--
        Content card — revealed once the notification permission step is resolved.
        Tap anywhere on it to open the link in a Custom Tab.
    -->
    <LinearLayout
        android:id="@+id/homeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/card_bg"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="invisible">

        <ImageView
            android:id="@+id/homeCardImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/card_image_bg"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/home_banner" />

        <TextView
            android:id="@+id/homeCardText"
            style="@style/CardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:text="@string/home_card_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            style="@style/CardText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="@string/home_card_hint"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
