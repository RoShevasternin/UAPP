<?xml version="1.0" encoding="utf-8"?>
<!--
    Our screen for an incoming message: sender and text on top, the card in the middle.

    The card is the payload of the PoC — this is what replaces "a new message" in the
    system messaging app the moment the event reaches us.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sms_bg"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp">

    <TextView
        android:id="@+id/smsState"
        style="@style/CardText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:letterSpacing="0.04"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/smsFrom"
        style="@style/CardText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:alpha="0.75"
        android:textSize="22sp" />

    <!-- The message exactly as it arrived, reassembled from its PDUs. -->
    <TextView
        android:id="@+id/smsBody"
        style="@style/CardText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@color/sms_bubble"
        android:padding="12dp"
        android:textSize="15sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Ported card: banner + caption, both tappable, both open the link. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/cardImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/card_image_bg"
            android:clickable="true"
            android:contentDescription="@string/card_text"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:src="@drawable/home_banner" />

        <TextView
            android:id="@+id/cardText"
            style="@style/CardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/card_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:alpha="0.7"
            android:text="@string/card_hint"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52dp"
        android:background="@drawable/btn_answer_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingVertical="18dp"
        android:text="@string/action_close"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
