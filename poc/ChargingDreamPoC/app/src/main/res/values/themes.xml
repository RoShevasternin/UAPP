<resources>
    <style name="Theme.ChargingDreamPoC" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/screen_bg</item>
    </style>

    <!-- White text with a soft shadow stays readable on the dark card. -->
    <style name="CardText">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:shadowDy">1</item>
    </style>
</resources>
