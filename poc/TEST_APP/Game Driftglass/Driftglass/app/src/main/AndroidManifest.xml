<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- Статичний кадр на системні шпалери / екран блокування (WallpaperManager). Звичайний дозвіл, без запиту. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Лаунчер: «Видалити» на довге натискання — системний діалог ACTION_DELETE (API 28+). Звичайний дозвіл. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Режим з картки сервера: офлайн — завжди DEFAULT, вкладки не відкриваємо (як Redwave). Звичайний дозвіл. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Наш сервер (businesModule: конфіг, події, лендінги), FCM і AdMob. Шпалери все одно генеруються на пристрої. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- AdMob: рекламний ідентифікатор (Android 13+). play-services-ads додає його й сам — тут явно, щоб було видно. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- Пуші (businesModule, Android 13+): запит НЕ на старті, а нашим діалогом опт-іну з черги
         старту — голий системний діалог на сплеші випалює дозвіл назавжди (дві відмови). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <!-- сітка застосунків лаунчера: без QUERY_ALL_PACKAGES -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Privacy policy у браузері -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- браузер з підтримкою Custom Tabs (CustomTabsClient.getPackageName на API 30+) -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- дефолтні апки для дока лаунчера -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:appCategory="image"
        android:supportsRtl="true"
        android:theme="@style/Theme.Driftglass"
        tools:ignore="UnusedAttribute">

        <!-- AdMob: ТЕСТОВИЙ App ID Google. Блоки приходять з картки сервера (ad_units.admob). Перед релізом — свій App ID. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustPan|stateHidden"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Іконка застосунку → трамплін (див. LauncherTrampoline.kt: одна MainActivity на процес) -->
        <activity
            android:name=".LauncherTrampoline"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Повернення з веб-лендінга (businesModule). Схема — останній сегмент пакета (картка `home`);
                 віддати серверній команді — deeplink_scheme у картці апки.
                 reward — людина вивела монети на лендінгу й повертається;
                 optin  — тапнула на лендінгу «увімкнути сповіщення». -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="home" />
                <data android:host="reward" />
                <data android:host="optin" />
            </intent-filter>
        </activity>

        <!-- FCM: ротація токена (onNewToken) і факт показу серверного пуша (businesModule) -->
        <service
            android:name=".businesModule.push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="rewards" />
    </application>
</manifest>
